#!/bin/sh
# Every commit: made as local@localhost and unsigned, no staged line naming a
# contributor (identity.sh), then the asset policy.
# Install with: cargo xtask install-hooks
. "$(dirname "$0")/identity.sh"
identity_config_ok || exit 1
if ! git diff --cached --no-color -U0 | grep -E '^\+' | grep -vE '^\+\+\+ ' | identity_text_ok; then
    echo "identity: a staged line names a contributor (above); take it out and commit again" >&2
    exit 1
fi
exec cargo xtask policy --staged
