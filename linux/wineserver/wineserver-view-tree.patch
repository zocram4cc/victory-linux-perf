--- i/server/mapping.c
+++ w/server/mapping.c
@@ -45,6 +45,7 @@
 #include "thread.h"
 #include "process.h"
 #include "request.h"
+#include "wine/rbtree.h"
 #include "security.h"
 
 /* list of memory ranges, used to store committed info */
@@ -131,6 +132,9 @@ static struct list shared_map_list = LIST_INIT( shared_map_list );
 struct memory_view
 {
     struct list     entry;           /* entry in per-process view list */
+    struct rb_entry tree_entry;      /* entry in view_tree, by (process, base) */
+    struct process *process;         /* process the view is in, once added */
+    int             in_tree;         /* whether tree_entry is in view_tree */
     struct fd      *fd;              /* fd for mapped file */
     struct ranges  *committed;       /* list of committed ranges in this mapping */
     struct shared_map *shared;       /* temp file for shared PE mapping */
@@ -429,11 +433,69 @@ static int create_temp_file( file_pos_t size )
     return fd;
 }
 
+/* All processes' views, by (process, base), next to each process's list
+ * (which keeps their order: exe first, then load order). With the list
+ * alone every map_view and unmap_view walked all of the process's views;
+ * a process with tens of thousands of views (a title aliasing GPU memory
+ * one 64 KiB page at a time) spent about a millisecond in each call and
+ * kept the server busy. */
+struct view_key
+{
+    const struct process *process;
+    client_ptr_t          base;
+};
+
+static int compare_view( const void *key, const struct rb_entry *entry )
+{
+    const struct view_key *k = key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry );
+
+    if (k->process != view->process) return k->process < view->process ? -1 : 1;
+    if (k->base != view->base) return k->base < view->base ? -1 : 1;
+    return 0;
+}
+
+static struct rb_tree view_tree = { compare_view };
+
+/* set if two views of one process ever had the same base: then the tree
+ * cannot stand for the lists, and the lists are walked as before */
+static int view_tree_unreliable;
+
+/* the view of the process with the greatest base <= addr */
+static struct memory_view *find_view_at_or_below( const struct process *process, client_ptr_t addr )
+{
+    struct rb_entry *entry = view_tree.root;
+    struct memory_view *best = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+
+        if (view->process < process || (view->process == process && view->base <= addr))
+        {
+            if (view->process == process) best = view;
+            entry = entry->right;
+        }
+        else entry = entry->left;
+    }
+    return best;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
     struct memory_view *view;
 
+    if (!view_tree_unreliable)
+    {
+        struct view_key key = { process, base };
+        struct rb_entry *entry = rb_get( &view_tree, &key );
+
+        if (entry) return RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        set_error( STATUS_NOT_MAPPED_VIEW );
+        return NULL;
+    }
+
     LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
         if (view->base == base) return view;
 
@@ -446,6 +508,14 @@ static struct memory_view *find_mapped_addr( struct process *process, client_ptr
 {
     struct memory_view *view;
 
+    if (!view_tree_unreliable)
+    {
+        view = find_view_at_or_below( process, addr );
+        if (view && addr < view->base + view->size) return view;
+        set_error( STATUS_NOT_MAPPED_VIEW );
+        return NULL;
+    }
+
     LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
         if (addr >= view->base && addr < view->base + view->size) return view;
 
@@ -462,7 +532,14 @@ static int is_valid_view_addr( struct process *process, client_ptr_t addr, mem_s
     if (addr & host_page_mask) return 0;
     if (addr + size < addr) return 0;  /* overflow */
 
-    /* check for overlapping view */
+    /* check for overlapping view: views do not overlap each other, so only
+     * the last one starting below the end of the range can reach into it */
+    if (!view_tree_unreliable)
+    {
+        view = find_view_at_or_below( process, addr + size - 1 );
+        return !view || view->base + view->size <= addr;
+    }
+
     LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
     {
         if (view->base + view->size <= addr) continue;
@@ -491,6 +568,17 @@ static int add_process_view( struct thread *thread, struct memory_view *view )
 {
     struct process *process = thread->process;
     struct unicode_str name;
+    struct view_key key = { process, view->base };
+
+    view->process = process;
+    view->in_tree = !rb_put( &view_tree, &key, &view->tree_entry );
+    if (!view->in_tree)
+    {
+        if (!view_tree_unreliable)
+            fprintf( stderr, "wineserver view tree: two views at base %#llx (size %#llx, flags %#x); falling back to the list\n",
+                     (unsigned long long)view->base, (unsigned long long)view->size, view->flags );
+        view_tree_unreliable = 1;
+    }
 
     if (view->flags & SEC_IMAGE)
     {
@@ -519,6 +601,7 @@ static void free_memory_view( struct memory_view *view )
     if (view->fd) release_object( view->fd );
     if (view->committed) release_object( view->committed );
     if (view->shared) release_object( view->shared );
+    if (view->in_tree) rb_remove( &view_tree, &view->tree_entry );
     list_remove( &view->entry );
     free( view );
 }
