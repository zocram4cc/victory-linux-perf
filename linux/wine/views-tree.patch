 struct memory_view
 {
     struct list     entry;           /* entry in per-process view list */
+    struct rb_entry tree_entry;      /* entry in per-process view tree */
+    struct process *tree_owner;      /* process whose list holds this view */
+    int             in_tree;         /* is it in that process's tree too? */
     struct fd      *fd;              /* fd for mapped file */
     struct ranges  *committed;       /* list of committed ranges in this mapping */
     struct shared_map *shared;       /* temp file for shared PE mapping */
@@ -429,11 +432,54 @@ static int create_temp_file( file_pos_t size )
     return fd;
 }
 
+static int view_compare( const void *key, const struct rb_entry *entry )
+{
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry );
+    client_ptr_t base = *(const client_ptr_t *)key;
+
+    if (base < view->base) return -1;
+    if (base > view->base) return 1;
+    return 0;
+}
+
+/* the view with the highest base address below 'limit', from the tree */
+static struct memory_view *find_view_below( struct process *process, client_ptr_t limit )
+{
+    struct rb_entry *entry = process->views_tree.root;
+    struct memory_view *view, *best = NULL;
+
+    while (entry)
+    {
+        view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        if (view->base < limit)
+        {
+            best = view;
+            entry = entry->right;
+        }
+        else entry = entry->left;
+    }
+    return best;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
     struct memory_view *view;
 
+    if (!process->views_untree)
+    {
+        struct rb_entry *entry = process->views_tree.root;
+
+        while (entry)
+        {
+            view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+            if (view->base == base) return view;
+            entry = base < view->base ? entry->left : entry->right;
+        }
+        set_error( STATUS_NOT_MAPPED_VIEW );
+        return NULL;
+    }
+
     LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
         if (view->base == base) return view;
 
