+    {
+        /* views do not overlap: if any reaches into the range, the last one that begins below its end does */
+        view = find_view_below( process, addr + size );
+        return !(view && view->base + view->size > addr);
+    }
     LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
     {
         if (view->base + view->size <= addr) continue;
@@ -492,6 +556,11 @@ static int add_process_view( struct thread *thread, struct memory_view *view )
     struct process *process = thread->process;
     struct unicode_str name;
 
+    if (!process->views_tree.compare) rb_init( &process->views_tree, view_compare );
+    view->tree_owner = process;
+    view->in_tree = !rb_put( &process->views_tree, &view->base, &view->tree_entry );
+    if (!view->in_tree) process->views_untree++;
+
     if (view->flags & SEC_IMAGE)
