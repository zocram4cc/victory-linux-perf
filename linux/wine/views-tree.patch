+    if (!process->views_untree)
+    {
+        /* views do not overlap: only the last one that begins at or below addr can hold it */
+        if (addr + 1 && (view = find_view_below( process, addr + 1 )) && addr - view->base < view->size)
+            return view;
+        if (addr + 1)
+        {
+            set_error( STATUS_NOT_MAPPED_VIEW );
+            return NULL;
+        }
+    }
+
