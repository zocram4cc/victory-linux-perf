# Machine settings for running under Proton: copy to linux/local.env (git-ignored) and set the paths.
# The switches below are the ones measured on an RX 9070 XT with RADV; each says where its number came from.
GAME_DIR='/path/to/your/own/dump/of/the/title'
STATE_DIR="$HOME/.local/share/victory-avatar"
# A private copy of Proton Hotfix (hotfix-20261110) whose wineserver finds a
# process's memory views through a tree instead of walking a list of all of
# them on every map and unmap (source, patch and build script are under
# linux/wine in this repo; Valve's server is kept there as
# wineserver.valve-original). Steam's own Proton Hotfix is untouched.
# VICTORY_STOCK_PROTON=1 runs on Steam's copy again. Same prefix, same saves.
if [ "${VICTORY_STOCK_PROTON-}" = 1 ] || [ ! -x "$STATE_DIR/proton-hotfix-tree/files/bin/wineserver" ]; then
    PROTONPATH="$HOME/.local/share/Steam/steamapps/common/Proton Hotfix"
elif [ -n "${VICTORY_PROTON_COPY-}" ] && [ -x "$STATE_DIR/proton-hotfix-$VICTORY_PROTON_COPY/files/bin/wineserver" ]; then
    # Another private copy by name, for trying a change to Wine without
    # touching the one in use: `ww` also has an ntdll.so that tracks writes
    # to mapped views in the kernel (linux/wine/views-writewatch.patch).
    PROTONPATH="$STATE_DIR/proton-hotfix-$VICTORY_PROTON_COPY"
else
    PROTONPATH="$STATE_DIR/proton-hotfix-tree"
fi
# A Windows 10 era d3dcompiler_47.dll (10.0.x), as many games ship beside their executable (see run.sh).
D3DCOMPILER="/path/to/a/d3dcompiler_47.dll"

# What its own launcher (scripts/play.ps1) sets, fast mode:
for kv in VICTORY_TEXTURE_NO_WAIT=1 VICTORY_RELAY=2 VICTORY_WIDE_BACK=1 VICTORY_CARD_REHASH_RUNS=1 VICTORY_JOIN_COPIES=1 \
          VICTORY_INDIRECT_WINDOW=1 VICTORY_RELAY_COPY=1 VICTORY_CARD_STEPS=2 VICTORY_INDIRECT_BATCH=2 VICTORY_MAP_THREADS=1 \
          VICTORY_TITLE_PRIORITIES=0 VICTORY_CARD_AWAKE=1 VICTORY_SHOW_AFTER=1 VICTORY_AMBIENT=0.8 VICTORY_SKIP_PIPELINES=none \
          VICTORY_THIN=1 VICTORY_JOIN_PARTS=8 VICTORY_UPLOAD_AHEAD=1; do
    k=${kv%%=*}; [[ -v $k ]] || export "$kv"
done

# Every run writes down the pipelines the title creates, so `linux/run.sh warm` can pre-build them
# (this repo's warm works from that list; without it pipelines compile on first use and things pop in late).
export VICTORY_PIPELINE_BOOK="${VICTORY_PIPELINE_BOOK-1}"
# Brought over with the Wine port:
export VICTORY_SKIP_BINK="${VICTORY_SKIP_BINK-1}"
export VICTORY_NO_WATCHDOG="${VICTORY_NO_WATCHDOG-1}"

# Host copies of 1 MiB and more live in the card's memory, so the compare of what shaders wrote runs on the
# card instead of the CPU (measured 2026-11-25: median 80 -> 60 ms a frame, 110 -> 28 MB compared on the CPU).
export VICTORY_CARD_BUFFERS_MIN_MB="${VICTORY_CARD_BUFFERS_MIN_MB-1}"

# Measured in one run with the switch flipping every 10 s (2026-11-26, run abP): frames were about 4 ms slower
# and the slow tenth much worse with it on. The other three "beside" switches measured 1-2 ms faster and stay on.
export VICTORY_GAPS_TOGETHER="${VICTORY_GAPS_TOGETHER-0}"

# A second half of helpers in the landing, under, views and records pools
# (land.rs, 2026-11-25). OFF: in a clean nine-minute run of on/off phases in
# these settings (wide2, 47 phases, 5,500 draws) it cost +2.8 ms +- 0.8 on the
# median frame. An earlier reading of -3.0 +- 2.4 was ten phases under the
# slow flicker switches. Measured in the same run and also left off (their
# defaults): VICTORY_WIDE_MORE -0.6 +- 1.1, VICTORY_TAKE_FINE +1.7 +- 1.1,
# VICTORY_GAPS_TOGETHER -0.9 +- 1.1 (so its earlier "+4 ms" was noise too).
export VICTORY_POOLS_MORE="${VICTORY_POOLS_MORE-0}"

# The layer's own numbers on the picture (host/panel.rs): a text box in the
# upper left corner, shown from the start; F3 hides and shows it while the
# game's window has the focus. VICTORY_PANEL=0 on the command line leaves it out.
export VICTORY_PANEL="${VICTORY_PANEL-1}"
