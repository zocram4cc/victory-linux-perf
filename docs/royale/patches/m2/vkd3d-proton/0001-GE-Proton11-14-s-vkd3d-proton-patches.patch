From f86e5ecec20beac8d2f9b7948f6045538c480ddc Mon Sep 17 00:00:00 2001
From: datingesp-hash <228639058+datingesp-hash@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:01:35 +0100
Subject: [PATCH 1/3] GE-Proton11-14's vkd3d-proton patches

---
 libs/vkd3d-common/platform.c | 27 ++++---------------------
 libs/vkd3d/command.c         | 27 +++++++++++++++++++++++--
 libs/vkd3d/device.c          |  2 +-
 libs/vkd3d/swapchain.c       | 39 ++++++++++++++++++++++++++++++------
 4 files changed, 63 insertions(+), 32 deletions(-)

diff --git a/libs/vkd3d-common/platform.c b/libs/vkd3d-common/platform.c
index e93cbf74..55359b76 100644
--- a/libs/vkd3d-common/platform.c
+++ b/libs/vkd3d-common/platform.c
@@ -289,8 +289,6 @@ enum vkd3d_application_engine_class vkd3d_get_engine_version(uint32_t *major, ui
     WCHAR exe_path[VKD3D_PATH_MAX], path[VKD3D_PATH_MAX];
     enum vkd3d_application_engine_class engine_class;
     const WCHAR *name;
-    HMODULE ntdll;
-    DWORD size;
 
     *major = *minor = *patch = 0;
     GetModuleFileNameW(NULL, exe_path, VKD3D_PATH_MAX);
@@ -310,27 +308,10 @@ enum vkd3d_application_engine_class vkd3d_get_engine_version(uint32_t *major, ui
     if ((engine_class = get_engine_version_from_exe(path, major, minor, patch, false)))
         return engine_class;
 
-    if ((ntdll = GetModuleHandleA("ntdll.dll")))
-    {
-        PFN_NtQueryInformationProcess pfn_NtQueryInformationProcess;
-        PROCESS_BASIC_INFORMATION pbi;
-        HANDLE parent;
-
-        pfn_NtQueryInformationProcess =
-            (PFN_NtQueryInformationProcess)(void *)GetProcAddress(ntdll, "NtQueryInformationProcess");
-
-        if (pfn_NtQueryInformationProcess &&
-            !pfn_NtQueryInformationProcess(GetCurrentProcess(), ProcessBasicInformation, &pbi, sizeof(pbi), NULL) &&
-           (parent = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, (DWORD)pbi.InheritedFromUniqueProcessId)))
-        {
-            size = ARRAY_SIZE(path);
-            if (QueryFullProcessImageNameW(parent, 0, path, &size))
-                engine_class = get_engine_version_from_exe(path, major, minor, patch, false);
-            CloseHandle(parent);
-            if (engine_class)
-                return engine_class;
-        }
-    }
+    /* Don't read the parent process's image for its version info.
+     * GetFileVersionInfo() maps the file into this process, and when the
+     * parent is an EAC bootstrapper (e.g. StarCitizen_Launcher.exe, hunt.exe)
+     * EAC reports it as an untrusted system file and kicks the game. */
 
     /* Dubious checks where we spelunk the filesystem. */
 
diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index b1941888..430fe2a9 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -8406,10 +8406,30 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
 
     if (dyn_state->viewport_count)
     {
+        /* In D3D12, viewports and scissors not defined by the last RSSetViewports call
+         * are disabled, so primitives that select them via SV_ViewportArrayIndex are
+         * dropped. In Vulkan, a ViewportIndex >= viewportCount is undefined, and RADV
+         * rasterizes such primitives with stale state from an earlier multi-viewport
+         * draw. Pad the unused slots with a valid viewport and an empty scissor so
+         * those primitives are discarded, as in D3D12. */
+        const VkPhysicalDeviceLimits *vp_limits = &list->device->device_info.properties2.properties.limits;
+        uint32_t padded_count = dyn_state->viewport_count;
+
+        if (list->device->device_info.features2.features.multiViewport)
+        {
+            padded_count = max(padded_count, min(vp_limits->maxViewports,
+                    (uint32_t)D3D12_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE));
+        }
+
         if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_VIEWPORT)
         {
+            VkViewport padded_viewports[D3D12_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE];
+
+            for (i = 0; i < padded_count; i++)
+                padded_viewports[i] = dyn_state->viewports[i < dyn_state->viewport_count ? i : 0];
+
             VK_CALL(vkCmdSetViewportWithCount(list->cmd.vk_command_buffer,
-                    dyn_state->viewport_count, dyn_state->viewports));
+                    padded_count, padded_viewports));
         }
 
         if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_SCISSOR)
@@ -8447,8 +8467,11 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
                 clamped_scissors[i].extent.height = min(scissor->extent.height, (uint32_t)(bottom_right.y - top_left.y));
             }
 
+            for (i = dyn_state->viewport_count; i < padded_count; i++)
+                memset(&clamped_scissors[i], 0, sizeof(clamped_scissors[i]));
+
             VK_CALL(vkCmdSetScissorWithCount(list->cmd.vk_command_buffer,
-                    dyn_state->viewport_count, clamped_scissors));
+                    padded_count, clamped_scissors));
         }
     }
     else
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 3139d6dd..6aa9234c 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -697,7 +697,7 @@ static HRESULT vkd3d_instance_init(struct vkd3d_instance *instance,
     /* Builds from dirty trees generate vkd3d_version ending with a '+'. */
     dirty_tree_build = sizeof(vkd3d_version) >= 2 && vkd3d_version[sizeof(vkd3d_version) - 2] == '+';
     if (dirty_tree_build)
-        INFO("vkd3d-proton - build: %015"PRIx64"+.\n", vkd3d_build >> 4);
+        INFO("vkd3d-proton - build: %015"PRIx64"+ (%s).\n", vkd3d_build >> 4, vkd3d_version);
     else
         INFO("vkd3d-proton - build: %015"PRIx64".\n", vkd3d_build);
 
diff --git a/libs/vkd3d/swapchain.c b/libs/vkd3d/swapchain.c
index 2c6e9c7e..9bf212cd 100644
--- a/libs/vkd3d/swapchain.c
+++ b/libs/vkd3d/swapchain.c
@@ -17,6 +17,7 @@
  */
 
 #define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#define VKD3D_PRESENT_WAIT_POLL_NS (100ull * 1000 * 1000)
 
 #ifdef _WIN32
 #include "vkd3d_win32.h"
@@ -543,6 +544,10 @@ static void dxgi_vk_swap_chain_cleanup_low_latency(struct dxgi_vk_swap_chain *ch
 
 static void dxgi_vk_swap_chain_cleanup_waiter_thread(struct dxgi_vk_swap_chain *chain)
 {
+    pthread_mutex_lock(&chain->wait_thread.lock);
+    chain->wait_thread.skip_waits = true;
+    pthread_mutex_unlock(&chain->wait_thread.lock);
+
     dxgi_vk_swap_chain_push_present_id(chain, 0, 0, 0, true);
     pthread_join(chain->wait_thread.thread, NULL);
     pthread_mutex_destroy(&chain->wait_thread.lock);
@@ -1664,6 +1669,16 @@ static void dxgi_vk_swap_chain_drain_waiter(struct dxgi_vk_swap_chain *chain)
     pthread_mutex_unlock(&chain->wait_thread.lock);
 }
 
+static bool dxgi_vk_swap_chain_should_skip_present_waits(struct dxgi_vk_swap_chain *chain)
+{
+    bool skip_waits;
+
+    pthread_mutex_lock(&chain->wait_thread.lock);
+    skip_waits = chain->wait_thread.skip_waits;
+    pthread_mutex_unlock(&chain->wait_thread.lock);
+    return skip_waits;
+}
+
 static void dxgi_vk_swap_chain_destroy_swapchain_in_present_task(struct dxgi_vk_swap_chain *chain)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
@@ -3635,8 +3650,10 @@ static void *dxgi_vk_swap_chain_wait_worker(void *chain_)
         {
             cookie = vkd3d_queue_timeline_trace_register_present_wait(timeline_trace, entry.id);
             /* In skip wait mode we just need to make sure that we signal latency fences properly. */
-            if (!chain->wait_thread.skip_waits)
+            if (!dxgi_vk_swap_chain_should_skip_present_waits(chain))
             {
+                VkResult vr;
+
                 /* We don't really care if we observed OUT_OF_DATE or something here. */
                 if (chain->present.wait2)
                 {
@@ -3644,14 +3661,24 @@ static void *dxgi_vk_swap_chain_wait_worker(void *chain_)
                     memset(&wait_info, 0, sizeof(wait_info));
                     wait_info.sType = VK_STRUCTURE_TYPE_PRESENT_WAIT_2_INFO_KHR;
                     wait_info.presentId = entry.id;
-                    wait_info.timeout = UINT64_MAX;
-                    VK_CALL(vkWaitForPresent2KHR(chain->queue->device->vk_device, chain->present.vk_swapchain,
-                            &wait_info));
+                    wait_info.timeout = VKD3D_PRESENT_WAIT_POLL_NS;
+                    do
+                    {
+                        vr = VK_CALL(vkWaitForPresent2KHR(chain->queue->device->vk_device,
+                                chain->present.vk_swapchain, &wait_info));
+                    }
+                    while (vr == VK_TIMEOUT &&
+                            !dxgi_vk_swap_chain_should_skip_present_waits(chain));
                 }
                 else
                 {
-                    VK_CALL(vkWaitForPresentKHR(chain->queue->device->vk_device, chain->present.vk_swapchain,
-                            entry.id, UINT64_MAX));
+                    do
+                    {
+                        vr = VK_CALL(vkWaitForPresentKHR(chain->queue->device->vk_device,
+                                chain->present.vk_swapchain, entry.id, VKD3D_PRESENT_WAIT_POLL_NS));
+                    }
+                    while (vr == VK_TIMEOUT &&
+                            !dxgi_vk_swap_chain_should_skip_present_waits(chain));
                 }
             }
             vkd3d_queue_timeline_trace_complete_present_wait(timeline_trace, cookie);
