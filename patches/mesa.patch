diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index ea78270..2ec51a2 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -22,8 +22,10 @@
 #include <sys/mman.h>
 #include "ac_linux_drm.h"
 
+#include "radv_um.h"
 #include "util/os_drm.h"
 #include "util/os_time.h"
+#include "util/rb_tree.h"
 #include "util/u_atomic.h"
 #include "util/u_math.h"
 #include "util/u_memory.h"
@@ -348,6 +350,833 @@ radv_amdgpu_global_bo_list_del(struct radv_amdgpu_winsys *ws, struct radv_amdgpu
    u_rwlock_wrunlock(&ws->global_bo_list.lock);
 }
 
+
+#define RADV_AMDGPU_UM_ZERO_SIZE (32ull << 20)
+#define RADV_AMDGPU_UM_PAD       4096ull
+
+struct radv_amdgpu_um_alias {
+   struct rb_node node;
+   uint64_t start;
+   uint64_t size;
+   uint64_t bo_offset;
+   struct radv_amdgpu_winsys_bo *bo;
+   bool cpu;
+};
+
+#define RADV_AMDGPU_UM_STRIDE (2ull << 30)
+#define RADV_AMDGPU_UM_CHUNK  0xf0000000ull
+
+static simple_mtx_t radv_amdgpu_um_mutex = SIMPLE_MTX_INITIALIZER;
+static struct radv_amdgpu_um *radv_amdgpu_um_first = NULL;
+
+struct radv_amdgpu_um *
+radv_amdgpu_um_acquire(uintptr_t cookie)
+{
+   struct radv_amdgpu_um *um;
+
+   simple_mtx_lock(&radv_amdgpu_um_mutex);
+   for (um = radv_amdgpu_um_first; um; um = um->next) {
+      if (um->cookie == cookie) {
+         um->refcount++;
+         simple_mtx_unlock(&radv_amdgpu_um_mutex);
+         return um;
+      }
+   }
+
+   um = calloc(1, sizeof(*um));
+   if (um) {
+      simple_mtx_init(&um->lock, mtx_plain);
+      u_rwlock_init(&um->bo_lock);
+      um->refcount = 1;
+      um->cookie = cookie;
+      const char *arena = getenv("RADV_VUM_MIRROR_ARENA");
+      const char *ordered = getenv("VICTORY_MIRROR_ARENA");
+      um->arena_requested = arena && !strcmp(arena, "1") && ordered && !strcmp(ordered, "1");
+      rb_tree_init(&um->aliases);
+      list_inithead(&um->mirrors);
+      um->next = radv_amdgpu_um_first;
+      radv_amdgpu_um_first = um;
+   }
+   simple_mtx_unlock(&radv_amdgpu_um_mutex);
+   return um;
+}
+
+void
+radv_amdgpu_um_release(struct radv_amdgpu_winsys *ws)
+{
+   struct radv_amdgpu_um *um = ws->um;
+   struct radeon_winsys_bo *zero_bo = NULL;
+   bool last;
+
+   if (!um)
+      return;
+
+   simple_mtx_lock(&radv_amdgpu_um_mutex);
+   last = !--um->refcount;
+   if (last) {
+      struct radv_amdgpu_um **link = &radv_amdgpu_um_first;
+      while (*link != um)
+         link = &(*link)->next;
+      *link = um->next;
+   }
+   simple_mtx_unlock(&radv_amdgpu_um_mutex);
+
+   ws->um = NULL;
+   if (!last)
+      return;
+
+   zero_bo = um->zero_bo;
+   um->zero_bo = NULL;
+   if (zero_bo)
+      ws->base.buffer_destroy(&ws->base, zero_bo);
+
+   while (!rb_tree_is_empty(&um->aliases)) {
+      struct rb_node *node = rb_tree_first(&um->aliases);
+      rb_tree_remove(&um->aliases, node);
+      free(node);
+   }
+   simple_mtx_destroy(&um->lock);
+   u_rwlock_destroy(&um->bo_lock);
+   free(um->bos);
+   free(um->dirty);
+   if (um->arena_handle)
+      ac_drm_va_range_free(um->arena_handle);
+   free(um);
+}
+
+static VkResult
+radv_amdgpu_um_list_bo(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, struct radv_amdgpu_winsys_bo *bo)
+{
+   if (bo->um_listed)
+      return VK_SUCCESS;
+
+   u_rwlock_wrlock(&um->bo_lock);
+   if (um->bo_count == um->bo_capacity) {
+      const uint32_t capacity = MAX2(64, um->bo_capacity * 2);
+      void *bos = realloc(um->bos, capacity * sizeof(*um->bos));
+      if (!bos) {
+         u_rwlock_wrunlock(&um->bo_lock);
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      }
+      um->bos = bos;
+      um->bo_capacity = capacity;
+   }
+   um->bos[um->bo_count++] = bo;
+   bo->um_listed = true;
+   bo->um_ws = ws;
+   u_rwlock_wrunlock(&um->bo_lock);
+   return VK_SUCCESS;
+}
+
+static void
+radv_amdgpu_um_unlist_bo(struct radv_amdgpu_um *um, struct radv_amdgpu_winsys_bo *bo)
+{
+   if (!bo->um_listed)
+      return;
+
+   u_rwlock_wrlock(&um->bo_lock);
+   for (uint32_t i = um->bo_count; i > 0; i--) {
+      if (um->bos[i - 1] == bo) {
+         um->bos[i - 1] = um->bos[--um->bo_count];
+         break;
+      }
+   }
+   bo->um_listed = false;
+   u_rwlock_wrunlock(&um->bo_lock);
+}
+
+unsigned
+radv_amdgpu_um_count_bos(struct radv_amdgpu_winsys *ws)
+{
+   return ws->um ? p_atomic_read(&ws->um->bo_count) : 0;
+}
+
+unsigned
+radv_amdgpu_um_copy_bos(struct radv_amdgpu_winsys *ws, struct drm_amdgpu_bo_list_entry *handles, unsigned num,
+                        unsigned max)
+{
+   struct radv_amdgpu_um *um = ws->um;
+
+   if (!um)
+      return num;
+
+   for (uint32_t i = 0; i < um->bo_count && num < max; i++) {
+      struct radv_amdgpu_winsys_bo *bo = um->bos[i];
+      if (bo->um_ws == ws)
+         continue;
+      handles[num].bo_handle = bo->bo_handle;
+      handles[num].bo_priority = bo->priority;
+      num++;
+   }
+   return num;
+}
+
+static int
+radv_amdgpu_um_alias_cmp_key(const struct rb_node *node, const void *key)
+{
+   const struct radv_amdgpu_um_alias *alias = (const struct radv_amdgpu_um_alias *)node;
+   const uint64_t start = *(const uint64_t *)key;
+   return start < alias->start ? -1 : start > alias->start ? 1 : 0;
+}
+
+static int
+radv_amdgpu_um_alias_cmp(const struct rb_node *a, const struct rb_node *b)
+{
+   const struct radv_amdgpu_um_alias *alias = (const struct radv_amdgpu_um_alias *)b;
+   return radv_amdgpu_um_alias_cmp_key(a, &alias->start);
+}
+
+static struct radv_amdgpu_um_alias *
+radv_amdgpu_um_first_overlap(struct radv_amdgpu_um *um, uint64_t start, uint64_t end)
+{
+   struct rb_node *node = rb_tree_search_sloppy(&um->aliases, &start, radv_amdgpu_um_alias_cmp_key);
+   struct radv_amdgpu_um_alias *alias = (struct radv_amdgpu_um_alias *)node;
+
+   if (!alias)
+      return NULL;
+
+   if (alias->start > start) {
+      struct radv_amdgpu_um_alias *prev = (struct radv_amdgpu_um_alias *)rb_node_prev(node);
+      if (prev && prev->start + prev->size > start)
+         alias = prev;
+   } else if (alias->start + alias->size <= start) {
+      alias = (struct radv_amdgpu_um_alias *)rb_node_next(node);
+      if (!alias)
+         return NULL;
+   }
+
+   return alias->start < end && alias->start + alias->size > start ? alias : NULL;
+}
+
+static struct radv_amdgpu_um_alias *
+radv_amdgpu_um_next_overlap(struct radv_amdgpu_um_alias *alias, uint64_t end)
+{
+   struct radv_amdgpu_um_alias *next = (struct radv_amdgpu_um_alias *)rb_node_next(&alias->node);
+   return next && next->start < end ? next : NULL;
+}
+
+static VkResult
+radv_amdgpu_um_zero_bo(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um)
+{
+   if (um->zero_bo)
+      return VK_SUCCESS;
+
+   struct radeon_winsys_bo *bo;
+   VkResult result = ws->base.buffer_create(&ws->base, RADV_AMDGPU_UM_ZERO_SIZE, 2 * 1024 * 1024, RADEON_DOMAIN_VRAM,
+                                            RADEON_FLAG_CPU_ACCESS | RADEON_FLAG_READ_ONLY |
+                                               RADEON_FLAG_NO_INTERPROCESS_SHARING | RADEON_FLAG_PREFER_LOCAL_BO,
+                                            RADV_BO_PRIORITY_VIRTUAL, 0, &bo);
+   if (result != VK_SUCCESS)
+      return result;
+   void *ptr = radv_buffer_map(&ws->base, bo);
+   if (!ptr) {
+      ws->base.buffer_destroy(&ws->base, bo);
+      return VK_ERROR_MEMORY_MAP_FAILED;
+   }
+   memset(ptr, 0, RADV_AMDGPU_UM_ZERO_SIZE);
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   ws->base.buffer_unmap(&ws->base, bo, false);
+   um->zero_bo = bo;
+   return VK_SUCCESS;
+}
+
+static int
+radv_amdgpu_um_mirror_zero(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um,
+                           uint64_t base_va, uint64_t offset, uint64_t size, uint32_t ops)
+{
+   const uint32_t zero_handle = radv_amdgpu_winsys_bo(um->zero_bo)->bo_handle;
+
+   while (size > 0) {
+      const uint64_t within = offset % RADV_AMDGPU_UM_ZERO_SIZE;
+      const uint64_t chunk = MIN2(size, RADV_AMDGPU_UM_ZERO_SIZE - within);
+      int r = radv_amdgpu_bo_va_op(ws, zero_handle, within, chunk, base_va + offset, RADEON_FLAG_READ_ONLY,
+                                   0, ops);
+      if (r)
+         return r;
+
+      offset += chunk;
+      size -= chunk;
+   }
+
+   return 0;
+}
+
+static int
+radv_amdgpu_um_write(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, uint64_t base_va,
+                     uint64_t offset, uint64_t size, struct radv_amdgpu_winsys_bo *bo, uint64_t bo_offset)
+{
+   if (!bo)
+      return radv_amdgpu_um_mirror_zero(ws, um, base_va, offset, size, AMDGPU_VA_OP_REPLACE);
+
+   return radv_amdgpu_bo_va_op(ws, bo->bo_handle, bo_offset, size, base_va + offset, bo->flags & RADEON_FLAG_GL2_BYPASS,
+                               0, AMDGPU_VA_OP_REPLACE);
+}
+
+static struct radv_amdgpu_um_range
+radv_amdgpu_um_chunk(struct radv_amdgpu_um *um, unsigned i)
+{
+   const uint64_t base = um->space_start + i * RADV_AMDGPU_UM_STRIDE;
+   return (struct radv_amdgpu_um_range){base, MIN2(base + RADV_AMDGPU_UM_CHUNK, um->space_end)};
+}
+
+static void
+radv_amdgpu_um_arena_coverage(struct radv_amdgpu_um *um)
+{
+   um->arena_count = 0;
+   for (uint64_t bits = um->arena_mask; bits; bits &= bits - 1) {
+      const struct radv_amdgpu_um_range r = radv_amdgpu_um_chunk(um, __builtin_ctzll(bits));
+      if (um->arena_count && um->arena_ranges[um->arena_count - 1].end >= r.start)
+         um->arena_ranges[um->arena_count - 1].end = r.end;
+      else
+         um->arena_ranges[um->arena_count++] = r;
+   }
+}
+
+static struct radv_amdgpu_um_range
+radv_amdgpu_um_arena_exclusive(struct radv_amdgpu_um *um, unsigned i, uint64_t pad)
+{
+   struct radv_amdgpu_um_range r = radv_amdgpu_um_chunk(um, i);
+   r.end += pad;
+   if (i && (um->arena_mask & (1ull << (i - 1))))
+      r.start = radv_amdgpu_um_chunk(um, i - 1).end + pad;
+   if (i < 63 && (um->arena_mask & (1ull << (i + 1))))
+      r.end = MIN2(r.end, radv_amdgpu_um_chunk(um, i + 1).start);
+   return r;
+}
+
+static int
+radv_amdgpu_um_arena_drop(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, unsigned i)
+{
+   const struct radv_amdgpu_um_range r = radv_amdgpu_um_arena_exclusive(um, i, RADV_AMDGPU_UM_PAD);
+   const struct radv_amdgpu_um_range content = radv_amdgpu_um_arena_exclusive(um, i, 0);
+   int result = 0;
+   if (r.start < r.end)
+      result = radv_amdgpu_bo_va_op(ws, 0, 0, r.end - r.start, um->arena_va + (r.start - um->space_start), 0, 0,
+                                    AMDGPU_VA_OP_CLEAR);
+   const uint64_t end = MIN2(content.end, r.start);
+   if (content.start < end) {
+      int zero = radv_amdgpu_um_mirror_zero(ws, um, um->arena_va, content.start - um->space_start, end - content.start,
+                                           AMDGPU_VA_OP_REPLACE);
+      if (zero)
+         result = zero;
+   }
+   return result;
+}
+
+static int
+radv_amdgpu_um_arena_fill(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, unsigned i)
+{
+   const struct radv_amdgpu_um_range r = radv_amdgpu_um_arena_exclusive(um, i, RADV_AMDGPU_UM_PAD);
+   const struct radv_amdgpu_um_range content = radv_amdgpu_um_arena_exclusive(um, i, 0);
+   if (r.start < r.end) {
+      int err = radv_amdgpu_um_mirror_zero(ws, um, um->arena_va, r.start - um->space_start, r.end - r.start,
+                                           AMDGPU_VA_OP_MAP);
+      if (err)
+         return err;
+   }
+   if (content.start >= content.end)
+      return 0;
+   for (struct radv_amdgpu_um_alias *alias = radv_amdgpu_um_first_overlap(um, content.start, content.end); alias;
+        alias = radv_amdgpu_um_next_overlap(alias, content.end)) {
+      const uint64_t from = MAX2(content.start, alias->start);
+      const uint64_t to = MIN2(content.end, alias->start + alias->size);
+      int err = radv_amdgpu_um_write(ws, um, um->arena_va, from - um->space_start, to - from, alias->bo,
+                                    alias->bo_offset + from - alias->start);
+      if (err)
+         return err;
+   }
+   return 0;
+}
+
+static bool
+radv_amdgpu_um_arena_window(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, uint64_t start, uint64_t size)
+{
+   if (!um->arena_requested || !um->space_end || (um->space_start & 0x1fffff) || start < um->space_start ||
+       start >= um->space_end || um->space_end - um->space_start > 64 * RADV_AMDGPU_UM_STRIDE)
+      return false;
+   const uint64_t offset = start - um->space_start;
+   if (offset % RADV_AMDGPU_UM_STRIDE || size != MIN2(RADV_AMDGPU_UM_CHUNK, um->space_end - start) ||
+       (um->arena_mask & (1ull << (offset / RADV_AMDGPU_UM_STRIDE))))
+      return false;
+   if (!um->arena_handle && ac_drm_va_range_alloc(ws->dev, amdgpu_gpu_va_range_general,
+                                                  um->space_end - um->space_start + RADV_AMDGPU_UM_PAD,
+                                                  MAX2(ws->info.pte_fragment_size, 2 * 1024 * 1024), 0,
+                                                  &um->arena_va, &um->arena_handle, AMDGPU_VA_RANGE_HIGH)) {
+      um->arena_requested = false;
+      return false;
+   }
+   return true;
+}
+
+static int
+radv_amdgpu_um_mirrors_update(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, uint64_t start, uint64_t size,
+                              struct radv_amdgpu_winsys_bo *bo, uint64_t bo_offset)
+{
+   const uint64_t end = start + size;
+   int result = 0;
+   for (unsigned i = 0; i < um->arena_count; ++i) {
+      const struct radv_amdgpu_um_range r = um->arena_ranges[i];
+      if (r.start >= end)
+         break;
+      const uint64_t from = MAX2(start, r.start);
+      const uint64_t to = MIN2(end, r.end);
+      if (from < to) {
+         int err = radv_amdgpu_um_write(ws, um, um->arena_va, from - um->space_start, to - from, bo,
+                                       bo_offset + (from - start));
+         if (err)
+            result = err;
+      }
+   }
+   list_for_each_entry (struct radv_amdgpu_winsys_bo, mirror, &um->mirrors, um_mirror_link) {
+      const uint64_t from = MAX2(start, mirror->um_mirror_start);
+      const uint64_t to = MIN2(end, mirror->um_mirror_start + mirror->base.size);
+      if (from < to) {
+         int err = radv_amdgpu_um_write(ws, um, mirror->base.va, from - mirror->um_mirror_start, to - from, bo,
+                                       bo_offset + (from - start));
+         if (err)
+            result = err;
+      }
+   }
+   if (result)
+      fprintf(stderr, "radv/amdgpu: Failed to update a unified memory mirror (%d).\n", result);
+   return result;
+}
+
+static bool
+radv_amdgpu_um_dirty(struct radv_amdgpu_um *um, uint64_t start, uint64_t end)
+{
+   if (um->dirty_count) {
+      struct radv_amdgpu_um_range *last = &um->dirty[um->dirty_count - 1];
+      if (start <= last->end && end >= last->start) {
+         last->start = MIN2(last->start, start);
+         last->end = MAX2(last->end, end);
+         return true;
+      }
+   }
+
+   if (um->dirty_count == um->dirty_capacity) {
+      const uint32_t capacity = MAX2(256, um->dirty_capacity * 2);
+      void *dirty = realloc(um->dirty, capacity * sizeof(*um->dirty));
+      if (!dirty)
+         return false;
+      um->dirty = dirty;
+      um->dirty_capacity = capacity;
+   }
+
+   um->dirty[um->dirty_count].start = start;
+   um->dirty[um->dirty_count].end = end;
+   p_atomic_set(&um->dirty_count, um->dirty_count + 1);
+   return true;
+}
+
+static int
+radv_amdgpu_um_range_cmp(const void *a, const void *b)
+{
+   const struct radv_amdgpu_um_range *x = a, *y = b;
+   return x->start < y->start ? -1 : x->start > y->start ? 1 : 0;
+}
+
+static void
+radv_amdgpu_um_flush_range(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um, uint64_t start, uint64_t end)
+{
+   struct radv_amdgpu_um_alias *alias = radv_amdgpu_um_first_overlap(um, start, end);
+   uint64_t at = start;
+
+   while (at < end) {
+      if (alias && alias->start <= at) {
+         struct radv_amdgpu_winsys_bo *bo = alias->bo;
+         const uint64_t bo_offset = alias->bo_offset + (at - alias->start);
+         uint64_t to = MIN2(end, alias->start + alias->size);
+         struct radv_amdgpu_um_alias *next = radv_amdgpu_um_next_overlap(alias, end);
+
+         while (next && next->start == to && next->bo == bo && next->bo_offset == bo_offset + (to - at)) {
+            to = MIN2(end, next->start + next->size);
+            next = radv_amdgpu_um_next_overlap(next, end);
+         }
+
+         radv_amdgpu_um_mirrors_update(ws, um, at, to - at, bo, bo_offset);
+         at = to;
+         alias = next;
+      } else {
+         const uint64_t to = alias ? MIN2(end, alias->start) : end;
+
+         radv_amdgpu_um_mirrors_update(ws, um, at, to - at, NULL, 0);
+         at = to;
+      }
+   }
+}
+
+static void
+radv_amdgpu_um_flush_locked(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_um *um)
+{
+   const uint32_t count = um->dirty_count;
+   uint64_t start, end;
+
+   if (!count)
+      return;
+
+   qsort(um->dirty, count, sizeof(*um->dirty), radv_amdgpu_um_range_cmp);
+
+   start = um->dirty[0].start;
+   end = um->dirty[0].end;
+   for (uint32_t i = 1; i < count; i++) {
+      if (um->dirty[i].start <= end) {
+         end = MAX2(end, um->dirty[i].end);
+         continue;
+      }
+      radv_amdgpu_um_flush_range(ws, um, start, end);
+      start = um->dirty[i].start;
+      end = um->dirty[i].end;
+   }
+   radv_amdgpu_um_flush_range(ws, um, start, end);
+
+   p_atomic_set(&um->dirty_count, 0);
+}
+
+void
+radv_amdgpu_um_flush(struct radv_amdgpu_winsys *ws)
+{
+   struct radv_amdgpu_um *um = ws->um;
+
+   if (!um || !p_atomic_read(&um->dirty_count))
+      return;
+
+   simple_mtx_lock(&um->lock);
+   radv_amdgpu_um_flush_locked(ws, um);
+   simple_mtx_unlock(&um->lock);
+}
+
+static struct radv_amdgpu_um_alias *
+radv_amdgpu_um_drop(struct radv_amdgpu_um *um, uint64_t start, uint64_t end, bool reserve,
+                    struct radv_amdgpu_um_alias *tail)
+{
+   struct radv_amdgpu_um_alias *alias = radv_amdgpu_um_first_overlap(um, start, end);
+
+   while (alias) {
+      struct radv_amdgpu_um_alias *next = radv_amdgpu_um_next_overlap(alias, end);
+      const uint64_t alias_end = alias->start + alias->size;
+      const uint64_t from = MAX2(start, alias->start);
+      const uint64_t to = MIN2(end, alias_end);
+
+      if (reserve && alias->cpu)
+         (void)mmap((void *)(uintptr_t)from, to - from, PROT_NONE,
+                    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0);
+
+      if (alias_end > end) {
+         assert(tail);
+         tail->start = end;
+         tail->size = alias_end - end;
+         tail->bo_offset = alias->bo_offset + (end - alias->start);
+         tail->bo = alias->bo;
+         tail->cpu = alias->cpu;
+         alias->bo->um_aliases++;
+         rb_tree_insert(&um->aliases, &tail->node, radv_amdgpu_um_alias_cmp);
+         tail = NULL;
+      }
+
+      if (alias->start < start) {
+         alias->size = start - alias->start;
+      } else {
+         alias->bo->um_aliases--;
+         rb_tree_remove(&um->aliases, &alias->node);
+         free(alias);
+      }
+
+      alias = next;
+   }
+
+   return tail;
+}
+
+static VkResult
+radv_amdgpu_winsys_bo_alias_map(struct radeon_winsys *_ws, struct radeon_winsys_bo *_bo, uint64_t offset,
+                                uint64_t size, void *addr, uint32_t prot)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   struct radv_amdgpu_winsys_bo *bo = radv_amdgpu_winsys_bo(_bo);
+   struct radv_amdgpu_um *um = ws->um;
+   const uint64_t start = (uintptr_t)addr;
+   struct radv_amdgpu_um_alias *alias, *tail;
+
+   if (um && (prot & VK_MEMORY_ALIAS_SPACE_BIT_RADV)) {
+      if (!size || ((size | start) & 4095))
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      simple_mtx_lock(&um->lock);
+      if (um->arena_handle && (um->space_start != start || um->space_end != start + size)) {
+         simple_mtx_unlock(&um->lock);
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      }
+      um->space_start = start;
+      um->space_end = start + size;
+      simple_mtx_unlock(&um->lock);
+      return VK_SUCCESS;
+   }
+
+   if (!um || bo->base.is_virtual || !size || ((offset | size | start) & 4095) || offset + size > bo->base.size)
+      return VK_ERROR_MEMORY_MAP_FAILED;
+
+   alias = calloc(1, sizeof(*alias));
+   tail = calloc(1, sizeof(*tail));
+   if (!alias || !tail) {
+      free(alias);
+      free(tail);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   simple_mtx_lock(&um->lock);
+
+   if (!bo->um_fd) {
+      uint32_t handle = 0;
+      int r = ac_drm_bo_export(ws->dev, bo->bo, amdgpu_bo_handle_type_dma_buf_fd, &handle);
+      if (r) {
+         simple_mtx_unlock(&um->lock);
+         free(alias);
+         free(tail);
+         fprintf(stderr, "radv/amdgpu: Unified memory needs exportable memory (%d).\n", r);
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      }
+      bo->um_fd = (int)handle + 1;
+   }
+
+   if (radv_amdgpu_um_list_bo(ws, um, bo) != VK_SUCCESS) {
+      simple_mtx_unlock(&um->lock);
+      free(alias);
+      free(tail);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   if (prot) {
+      void *data = mmap(addr, size, prot & (PROT_READ | PROT_WRITE), MAP_SHARED | MAP_FIXED, bo->um_fd - 1, offset);
+      if (data == MAP_FAILED) {
+         simple_mtx_unlock(&um->lock);
+         free(alias);
+         free(tail);
+         return VK_ERROR_MEMORY_MAP_FAILED;
+      }
+   }
+
+   free(radv_amdgpu_um_drop(um, start, start + size, false, tail));
+
+   alias->start = start;
+   alias->size = size;
+   alias->bo_offset = offset;
+   alias->bo = bo;
+   alias->cpu = prot != 0;
+   bo->um_aliases++;
+   rb_tree_insert(&um->aliases, &alias->node, radv_amdgpu_um_alias_cmp);
+
+   if (!radv_amdgpu_um_dirty(um, start, start + size) &&
+       radv_amdgpu_um_mirrors_update(ws, um, start, size, bo, offset)) {
+      radv_amdgpu_um_drop(um, start, start + size, true, NULL);
+      radv_amdgpu_um_mirrors_update(ws, um, start, size, NULL, 0);
+      simple_mtx_unlock(&um->lock);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   simple_mtx_unlock(&um->lock);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_amdgpu_winsys_bo_alias_unmap(struct radeon_winsys *_ws, void *addr, uint64_t size)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   struct radv_amdgpu_um *um = ws->um;
+   const uint64_t start = (uintptr_t)addr;
+   struct radv_amdgpu_um_alias *tail;
+   int r = 0;
+
+   if (!um || !size || ((size | start) & 4095))
+      return VK_ERROR_MEMORY_MAP_FAILED;
+
+   tail = calloc(1, sizeof(*tail));
+   if (!tail)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   simple_mtx_lock(&um->lock);
+   if (radv_amdgpu_um_first_overlap(um, start, start + size)) {
+      tail = radv_amdgpu_um_drop(um, start, start + size, true, tail);
+      if (!radv_amdgpu_um_dirty(um, start, start + size))
+         r = radv_amdgpu_um_mirrors_update(ws, um, start, size, NULL, 0);
+   }
+   simple_mtx_unlock(&um->lock);
+   free(tail);
+
+   return r ? VK_ERROR_OUT_OF_DEVICE_MEMORY : VK_SUCCESS;
+}
+
+static void
+radv_amdgpu_um_bo_gone(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_winsys_bo *bo)
+{
+   struct radv_amdgpu_um *um = ws->um;
+
+   if (um && bo->um_listed && p_atomic_read(&um->dirty_count)) {
+      simple_mtx_lock(&um->lock);
+      radv_amdgpu_um_flush_locked(ws, um);
+      simple_mtx_unlock(&um->lock);
+   }
+
+   if (um && bo->um_aliases) {
+      simple_mtx_lock(&um->lock);
+      struct radv_amdgpu_um_alias *alias = (struct radv_amdgpu_um_alias *)rb_tree_first(&um->aliases);
+      while (alias && bo->um_aliases) {
+         struct radv_amdgpu_um_alias *next = (struct radv_amdgpu_um_alias *)rb_node_next(&alias->node);
+         if (alias->bo == bo) {
+            const uint64_t start = alias->start, size = alias->size;
+            radv_amdgpu_um_drop(um, start, start + size, true, NULL);
+            radv_amdgpu_um_mirrors_update(ws, um, start, size, NULL, 0);
+         }
+         alias = next;
+      }
+      simple_mtx_unlock(&um->lock);
+   }
+
+   if (um)
+      radv_amdgpu_um_unlist_bo(um, bo);
+
+   if (bo->um_fd) {
+      close(bo->um_fd - 1);
+      bo->um_fd = 0;
+   }
+}
+
+static VkResult
+radv_amdgpu_um_mirror_create(struct radv_amdgpu_winsys *ws, void *pointer, uint64_t size,
+                             struct radeon_winsys_bo **out_bo)
+{
+   struct radv_amdgpu_um *um = ws->um;
+   const uint64_t start = (uintptr_t)pointer;
+   const uint64_t end = start + size;
+   struct radv_amdgpu_winsys_bo *bo;
+   amdgpu_va_handle va_handle;
+   uint64_t va = 0;
+   VkResult result;
+
+   *out_bo = NULL;
+
+   if (!um || ((size | start) & 4095))
+      return VK_INCOMPLETE;
+
+   simple_mtx_lock(&um->lock);
+
+   if (!(start >= um->space_start && end <= um->space_end) && !radv_amdgpu_um_first_overlap(um, start, end)) {
+      simple_mtx_unlock(&um->lock);
+      return VK_INCOMPLETE;
+   }
+
+   result = radv_amdgpu_um_zero_bo(ws, um);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   bo = CALLOC_STRUCT(radv_amdgpu_winsys_bo);
+   if (!bo) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail;
+   }
+
+   bo->um_arena = radv_amdgpu_um_arena_window(ws, um, start, size);
+   if (bo->um_arena) {
+      va = um->arena_va + (start - um->space_start);
+      va_handle = NULL;
+   } else if (ac_drm_va_range_alloc(ws->dev, amdgpu_gpu_va_range_general, size + RADV_AMDGPU_UM_PAD,
+                             MAX2(ws->info.pte_fragment_size, 2 * 1024 * 1024), 0, &va, &va_handle,
+                             AMDGPU_VA_RANGE_HIGH)) {
+      FREE(bo);
+      result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      goto fail;
+   }
+
+   bo->base.va = va;
+   bo->base.size = size;
+   bo->base.is_virtual = true;
+   bo->base.initial_domain = RADEON_DOMAIN_GTT;
+   bo->va_handle = va_handle;
+   bo->um_mirror = true;
+   bo->um_mirror_start = start;
+
+   if (bo->um_arena) {
+      const unsigned chunk = (start - um->space_start) / RADV_AMDGPU_UM_STRIDE;
+      if (radv_amdgpu_um_arena_fill(ws, um, chunk)) {
+         radv_amdgpu_um_arena_drop(ws, um, chunk);
+         FREE(bo);
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto fail;
+      }
+      um->arena_mask |= 1ull << chunk;
+      radv_amdgpu_um_arena_coverage(um);
+      goto ready;
+   }
+
+   if (radv_amdgpu_um_mirror_zero(ws, um, va, 0, size + RADV_AMDGPU_UM_PAD, AMDGPU_VA_OP_MAP)) {
+      radv_amdgpu_bo_va_op(ws, 0, 0, size + RADV_AMDGPU_UM_PAD, va, 0, 0, AMDGPU_VA_OP_CLEAR);
+      ac_drm_va_range_free(va_handle);
+      FREE(bo);
+      result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      goto fail;
+   }
+
+   list_addtail(&bo->um_mirror_link, &um->mirrors);
+
+   for (struct radv_amdgpu_um_alias *alias = radv_amdgpu_um_first_overlap(um, start, end); alias;
+        alias = radv_amdgpu_um_next_overlap(alias, end)) {
+      const uint64_t from = MAX2(start, alias->start);
+      const uint64_t to = MIN2(end, alias->start + alias->size);
+      int r = radv_amdgpu_bo_va_op(ws, alias->bo->bo_handle, alias->bo_offset + (from - alias->start), to - from,
+                                   va + (from - start), alias->bo->flags & RADEON_FLAG_GL2_BYPASS, 0,
+                                   AMDGPU_VA_OP_REPLACE);
+      if (r) {
+         fprintf(stderr, "radv/amdgpu: Failed to fill a unified memory mirror (%d).\n", r);
+         list_del(&bo->um_mirror_link);
+         radv_amdgpu_bo_va_op(ws, 0, 0, size + RADV_AMDGPU_UM_PAD, va, 0, 0, AMDGPU_VA_OP_CLEAR);
+         ac_drm_va_range_free(va_handle);
+         FREE(bo);
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto fail;
+      }
+   }
+
+ready:
+   simple_mtx_unlock(&um->lock);
+
+   radv_amdgpu_log_bo(ws, bo, false);
+
+   *out_bo = (struct radeon_winsys_bo *)bo;
+   return VK_SUCCESS;
+
+fail:
+   simple_mtx_unlock(&um->lock);
+   return result;
+}
+
+static void
+radv_amdgpu_um_mirror_destroy(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_winsys_bo *bo)
+{
+   struct radv_amdgpu_um *um = ws->um;
+
+   simple_mtx_lock(&um->lock);
+   if (bo->um_arena) {
+      const unsigned chunk = (bo->um_mirror_start - um->space_start) / RADV_AMDGPU_UM_STRIDE;
+      um->arena_mask &= ~(1ull << chunk);
+      int r = radv_amdgpu_um_arena_drop(ws, um, chunk);
+      if (r)
+         fprintf(stderr, "radv/amdgpu: Failed to retire a unified memory window (%d).\n", r);
+      radv_amdgpu_um_arena_coverage(um);
+      simple_mtx_unlock(&um->lock);
+      FREE(bo);
+      return;
+   }
+   list_del(&bo->um_mirror_link);
+   simple_mtx_unlock(&um->lock);
+
+   int r = radv_amdgpu_bo_va_op(ws, 0, 0, bo->base.size + RADV_AMDGPU_UM_PAD, bo->base.va, 0, 0, AMDGPU_VA_OP_CLEAR);
+   if (r)
+      fprintf(stderr, "radv/amdgpu: Failed to clear a unified memory mirror (%d).\n", r);
+
+   ac_drm_va_range_free(bo->va_handle);
+   FREE(bo);
+}
