From 8e70ac0991dff0f911ba6a0258f71eea6f3e3967 Mon Sep 17 00:00:00 2001
From: skornuta <126527569+skornuta@users.noreply.github.com>
Date: Thu, 26 Nov 2026 11:57:53 -0800
Subject: [PATCH 02/27] victory-gpu: make the test target compile again

Two tests from the Neptune import no longer built against the code they
test: `Spans::note` takes a resource description now, and `Card` has the
transient window's `chunks` and `flagged` and an optional staging side.
The calls are brought up to date and nothing else.

Three tests that now run fail as they did before this change (checked
with the tree's other changes set aside): the spans test (an overlapping
newer span evicts the older ones under the current `note`), and
`warp_card_patch_writes_the_masked_bytes_and_no_others` and
`warp_card_fetch_copies_flagged_pieces_to_their_slots`. Left as found.

(cherry picked from commit 49dd4c772159e9a0866c98280c593374fcb7e68d)
---
 crates/victory-gpu/src/descriptor/host.rs | 6 +++---
 crates/victory-gpu/src/shadow.rs          | 4 +++-
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index 1842b06..f7d98ac 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -3659,11 +3659,11 @@ mod tests {
         let mut spans = Spans::default();
         // A 512x512 texture of 0x56000 bytes viewed from levels 3 and 1,
         // and the next one 0x6000 after it (run 188).
-        spans.note(1, 0x1_0000, 0x1_0000 + 0x5_6000, true);
+        spans.note(1, 0x1_0000, 0x1_0000 + 0x5_6000, &[0; 14], true);
         spans.shows(1, 3);
-        spans.note(2, 0x1_0000, 0x1_0000 + 0x5_6000, true);
+        spans.note(2, 0x1_0000, 0x1_0000 + 0x5_6000, &[0; 14], true);
         spans.shows(2, 1);
-        spans.note(3, 0x1_6000, 0x1_6000 + 0x5_6000, true);
+        spans.note(3, 0x1_6000, 0x1_6000 + 0x5_6000, &[0; 14], true);
         assert_eq!(spans.next_start(0x1_0000, 0x1_0000 + 0x5_6000), Some(0x1_6000));
         assert_eq!(spans.next_start(0x1_6000, 0x1_6000 + 0x5_6000), None);
         assert_eq!(spans.first_viewed(0x1_0000), Some(1));
diff --git a/crates/victory-gpu/src/shadow.rs b/crates/victory-gpu/src/shadow.rs
index 166bb22..67c59ff 100644
--- a/crates/victory-gpu/src/shadow.rs
+++ b/crates/victory-gpu/src/shadow.rs
@@ -4659,7 +4659,9 @@ mod card_merge_tests {
             side[title_byte] = title[title_byte];
             let mut shadow = Shadow::new(buffer.clone(), side.as_mut_ptr(), 0, title.as_ptr() as u64, LEN as u64);
             shadow.card = Some(Card {
-                staging: staging.clone(),
+                staging: Some(staging.clone()),
+                chunks: Mutex::default(),
+                flagged: std::sync::atomic::AtomicBool::new(false),
                 before: Mutex::new(None),
                 dirty: Mutex::default(),
                 sent: Mutex::new(vec![(title_byte, title_byte + 1, 7)]),
-- 
