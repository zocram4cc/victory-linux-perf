index 1ed4cd4..9248067 100644
--- a/crates/victory-gpu/src/host.rs
+++ b/crates/victory-gpu/src/host.rs
@@ -938,6 +938,79 @@ pub(crate) fn allocator_trim() -> Option<u64> {
