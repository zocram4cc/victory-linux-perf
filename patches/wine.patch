-/* find a memory view from its base address */
+static int compare_view( const void *key, const struct rb_entry *entry )
+{
+    client_ptr_t addr = *(const client_ptr_t *)key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, node );
+    return addr < view->base ? -1 : addr > view->base;
+}
+
+static int profile_views;
+
+void init_view_tree( struct process *process )
+{
+    rb_init( &process->view_tree, compare_view );
+    profile_views = getenv( "VICTORY_WINE_VIEW_PROFILE" ) && !strcmp( getenv( "VICTORY_WINE_VIEW_PROFILE" ), "1" );
+}
+
+static struct memory_view *query_view( struct process *process, client_ptr_t first, client_ptr_t last, int exact )
+{
+    struct rb_entry *node = process->view_tree.root;
+    struct memory_view *found = NULL;
+    static unsigned int calls, samples, differences;
+    static timeout_t tree_ticks, list_ticks;
+    int sample = profile_views && !(++calls & 31);
+    timeout_t t = sample ? monotonic_counter() : 0;
+
+    while (node)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( node, struct memory_view, node );
+        if (view->base > last) node = node->left;
+        else if (view->base + view->size <= first) node = node->right;
+        else
+        {
+            if (!exact || view->base == first) found = view;
+            break;
+        }
+    }
+    if (sample)
+    {
+        struct memory_view *view, *reference = NULL;
+        timeout_t end = monotonic_counter();
+        tree_ticks += end - t;
+        LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+            if (view->base <= last && view->base + view->size > first && (!exact || view->base == first))
+            {
+                reference = view;
+                break;
+            }
+        list_ticks += monotonic_counter() - end;
+        if (!!reference != !!found || (first == last && reference != found)) differences++;
+        if (++samples == 8)
+        {
+            fprintf( stderr, "view lookup: %u samples, %.2f us tree, %.2f us list, %u differences\n",
+                     samples, tree_ticks / (samples * 10.0), list_ticks / (samples * 10.0), differences );
+            samples = differences = 0;
+            tree_ticks = list_ticks = 0;
+        }
+    }
+    return found;
+}
