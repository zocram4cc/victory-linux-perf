From 807d3ca5c83b73eea5a0876f04e015b6bd4480e0 Mon Sep 17 00:00:00 2001
From: skornuta <126527569+skornuta@users.noreply.github.com>
Date: Thu, 26 Nov 2026 16:41:00 -0800
Subject: [PATCH 10/27] Bindless eviction: only copies that lived the whole
 idle time

The first live run with VICTORY_BINDLESS_FEEDBACK=1 let go of 2,564 MB
in its first minute in the world, and 457 copies came back within 2 s.
The feedback had watched since the menus, so it "covered" the idle time,
but the world's textures had just been made, streamed in ahead of the
frames that draw them: never read was taken for idle. A texture now takes
the feedback's way only if its copy was made (or last asked for) the
feedback's whole idle time ago (VICTORY_BINDLESS_IDLE_S, 45 s); one made
since is blocked as before, and one made again after an unpark waits the
whole time again.

(cherry picked from commit 9c0c61b2ab194c1a52b78f49e898514a7a1aaf44)
---
 crates/victory-gpu/src/descriptor.rs |  4 ++++
 crates/victory-gpu/src/resource.rs   | 14 ++++++++++++--
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor.rs b/crates/victory-gpu/src/descriptor.rs
index 2058b71..5546b65 100644
--- a/crates/victory-gpu/src/descriptor.rs
+++ b/crates/victory-gpu/src/descriptor.rs
@@ -823,6 +823,7 @@ pub(crate) fn evictable_slots(
     frame: u64,
     cutoff: u64,
     fb_cutoff: Option<u64>,
+    fb_old: &std::collections::HashSet<usize>,
 ) -> (std::collections::HashMap<usize, Vec<(usize, u32, bool)>>, u64, u64) {
     let set: std::collections::HashSet<usize> = raws.keys().copied().collect();
     let heaps: Vec<usize> = SHADER_HEAPS
@@ -840,6 +841,9 @@ pub(crate) fn evictable_slots(
             continue;
         };
         for (index, raw, ok, lately, bindless) in host.slots_showing(&set, frame, cutoff, fb_cutoff) {
+            // (Neptune) The feedback's way only for copies that lived its whole idle time.
+            let fresh = bindless && !fb_old.contains(&raw);
+            let (ok, bindless) = (ok && !fresh, bindless && !fresh);
             if lately {
                 seen.insert(raw);
             }
diff --git a/crates/victory-gpu/src/resource.rs b/crates/victory-gpu/src/resource.rs
index 4af16f3..863635d 100644
--- a/crates/victory-gpu/src/resource.rs
+++ b/crates/victory-gpu/src/resource.rs
@@ -2196,6 +2196,7 @@ fn slot_evict(video: Option<[u64; 4]>, idle_ms: u64, frames: u64) {
     };
     let mut copies = Vec::new();
     let mut raws = std::collections::HashMap::new();
+    let mut fb_old = std::collections::HashSet::new();
     for &at in textures().iter() {
         // SAFETY: as in `pressure_victims`.
         let r = unsafe { &*(at as *const Resource) };
@@ -2211,14 +2212,23 @@ fn slot_evict(video: Option<[u64; 4]>, idle_ms: u64, frames: u64) {
             let stamp = r.host.used.load(Relaxed);
             if crate::host::long_ago(stamp, idle_ms, frames) && std::sync::Arc::strong_count(host) == 1 {
                 copies.push((at, stamp, host.bytes));
-                raws.insert(windows::core::Interface::as_raw(&host.texture) as usize, at);
+                let raw = windows::core::Interface::as_raw(&host.texture) as usize;
+                raws.insert(raw, at);
+                // (Neptune) Bindless: only a copy made (or last asked for) the feedback's whole
+                // idle time ago. One made since may not have been drawn yet (the world's
+                // textures stream in ahead of the frames that show them): never read is not
+                // idle. A first run let go of such copies as they arrived, and 457 came back
+                // within 2 s.
+                if fb_cutoff.is_some() && crate::host::long_ago(stamp, crate::feedback::idle_ms(), frames) {
+                    fb_old.insert(raw);
+                }
             }
         }
     }
     if copies.is_empty() {
         return;
     }
-    let (slots, kept, blocked) = crate::descriptor::evictable_slots(&raws, frame, cutoff, fb_cutoff);
+    let (slots, kept, blocked) = crate::descriptor::evictable_slots(&raws, frame, cutoff, fb_cutoff, &fb_old);
     SLOT_STATE[3].store(raws.len() as u64, Relaxed);
     SLOT_STATE[2].store(blocked, Relaxed);
     SLOT_STATE[1].store(kept, Relaxed);
-- 
2.55.0.windows.3

