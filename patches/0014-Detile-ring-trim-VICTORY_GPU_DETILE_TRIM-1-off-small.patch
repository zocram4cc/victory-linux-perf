     STATE.lock().unwrap_or_else(|e| e.into_inner()).as_ref().map(|s| s.out.0.clone())
@@ -626,6 +710,13 @@ pub(crate) fn reserve(layout: &Layout, subs: &[Sub], raw_len: u64, out_len: u64)
