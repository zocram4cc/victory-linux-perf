+        }
+    }
     if raw_len > state.raw_arena.size() || out_len > state.out_arena.size() || raw_len > u64::from(u32::MAX) {
         return Err(Why::TooBig);
     }
@@ -636,7 +727,11 @@ pub(crate) fn reserve(layout: &Layout, subs: &[Sub], raw_len: u64, out_len: u64)
