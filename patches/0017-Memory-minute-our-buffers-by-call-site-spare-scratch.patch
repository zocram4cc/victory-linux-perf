+                crate::memtel::track(&buffer, crate::memtel::SHARED, size, site);
                 Some((buffer, data.cast()))
             }
             Err(e) => {
@@ -9116,7 +9160,9 @@ impl Host {
     /// memory is write-combined: a read is very slow); shaders and copies only read it, so it has
